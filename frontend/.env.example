# Oryenza Talent Services - Frontend Environment Configuration

# Local Development:
# By default, Vite proxies requests to http://localhost:5000 via vite.config.js, so leave empty:
# VITE_API_BASE_URL=/api

# Production / Vercel Deployment:
# When deploying the frontend to Vercel, set this to your hosted backend API URL:
# Example: VITE_API_BASE_URL=https://oryenza-talent-api.onrender.com/api
VITE_API_BASE_URL=
