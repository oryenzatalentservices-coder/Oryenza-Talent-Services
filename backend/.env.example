# Oryenza Talent Services - Backend Environment Configuration (Example)
PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=oryenza_talent_db
DB_PORT=3306

# Uploads Security Configuration
UPLOAD_MAX_SIZE_MB=8
ALLOWED_FILE_TYPES=pdf,doc,docx

# Admin Access Authentication Key (Used in x-admin-key or Authorization: Bearer <key>)
ADMIN_SECRET_KEY=oryenza_admin_2026_change_in_production
